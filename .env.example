# Copy to .env.local for local development. Set the real values in
# Netlify → Site configuration → Environment variables. Never commit secrets.

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://theartofconnect.com

# ── Launch lock (master safety switch) ─────────────────────────────
# While "true", registrations, live payments and every experience stay
# closed no matter what the Owner Portal says. Set to "false" only when
# the owner authorizes launch; then each feature is switched on
# individually in Owner Portal → Launch Controls.
LAUNCH_LOCK=true

# ── Supabase (Project Settings → API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# New-format publishable key (sb_publishable_…). The legacy name
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_…). Bypasses row-level security; never
# expose to the browser. Legacy name SUPABASE_SERVICE_ROLE_KEY also accepted.
SUPABASE_SECRET_KEY=

# ── Stripe (use test keys sk_test_/pk_test_ until launch) ──────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. The Art of Connect <hello@theartofconnect.com>
EMAIL_FROM=
EMAIL_REPLY_TO=info@theartofconnect.com
